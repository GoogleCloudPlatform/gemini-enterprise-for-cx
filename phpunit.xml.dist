<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    bootstrap="tests/bootstrap.php"
    backupGlobals="false"
    colors="true"
    processIsolation="false"
    stopOnFailure="false">
    <testsuites>
        <testsuite name="Gemini Enterprise for CX Test Suite">
            <directory suffix="Test.php">./tests</directory>
        </testsuite>
    </testsuites>
    <!--
    processUncoveredFiles is deliberately left off (PHPUnit defaults it to
    false). Turning it on makes PHPUnit include_once every file listed here
    that no test loaded, and uninstall.php answers a bare include with `die;`
    while the plugin entrypoints re-declare classes the suite has already
    loaded. Either one ends the run.
    -->
    <coverage>
        <include>
            <directory suffix=".php">./includes</directory>
        </include>
    </coverage>
</phpunit>
