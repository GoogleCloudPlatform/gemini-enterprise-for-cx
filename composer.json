{
    "name": "google/gemini-enterprise-for-cx",
    "description": "Drive sales with an AI agent that's already an expert on your brand and products. Go live instantly on your WooCommerce storefront.",
    "type": "wordpress-plugin",
    "license": "GPL-3.0-or-later",
    "homepage": "https://github.com/GoogleCloudPlatform/gemini-enterprise-for-cx",
    "require": {
        "php": ">=7.4"
    },
    "autoload": {
        "psr-4": {
            "Google\\Gemini_Enterprise_For_CX\\": "includes/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "woocommerce/qit-cli": "^1.3"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "7.4"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml.dist",
        "lint": "phpcs",
        "lint:all": "phpcs",
        "lint:fix": "phpcbf",
        "qit:validate": "qit woo:validate-zip"
    }
}
