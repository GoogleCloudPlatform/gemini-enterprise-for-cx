<?xml version="1.0"?>
<ruleset name="Gemini Enterprise for CX">
    <description>Coding standards for the Gemini Enterprise for CX WooCommerce plugin.</description>

    <file>.</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg name="parallel" value="8"/>
    <arg value="sp"/>

    <!-- Matches the "Requires at least" and "Requires PHP" plugin headers. -->
    <config name="minimum_wp_version" value="6.2"/>
    <config name="testVersion" value="7.4-"/>

    <!--
    WordPress-Extra is WordPress-Core plus the correctness and best-practice
    sniffs. WordPress-Docs is deliberately not included: it enforces a comment
    format that is not required by the plugin directory and that this codebase
    does not follow.
    -->
    <rule ref="WordPress-Extra">
        <!--
        This codebase indents with four spaces and uses short array syntax.
        Both differ from WordPress core style. Reformatting ~5k lines would
        rewrite the blame history of every file for no functional gain, so the
        purely cosmetic sniffs are excluded and the substantive ones (security,
        escaping, sanitization, i18n, WP API usage) are enforced.
        -->
        <exclude name="Generic.WhiteSpace.DisallowSpaceIndent"/>
        <exclude name="Universal.WhiteSpace.PrecisionAlignment"/>
        <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
        <exclude name="Generic.Formatting.MultipleStatementAlignment"/>
        <exclude name="WordPress.Arrays.MultipleStatementAlignment"/>
        <exclude name="PEAR.Functions.FunctionCallSignature"/>
        <exclude name="Squiz.Functions.MultiLineFunctionDeclaration"/>
    </rule>

    <!-- manage_woocommerce is registered by WooCommerce, not by WordPress core. -->
    <rule ref="WordPress.WP.Capabilities">
        <properties>
            <property name="custom_capabilities" type="array">
                <element value="manage_woocommerce"/>
            </property>
        </properties>
    </rule>

    <!-- Every translatable string must use the plugin's own text domain. -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="gemini-enterprise-for-cx"/>
            </property>
        </properties>
    </rule>

    <!-- Everything the plugin declares must exist on the oldest supported PHP. -->
    <rule ref="PHPCompatibilityWP"/>
</ruleset>
